{
  "manifest_version": 3,
  "name": "Recaho Extender",
  "version": "3.4",
  "description": "Extend your recaho features",
  "icons": {

    "16": "icons/rehelper.png",

    "32": "icons/rehelper.png",

    "48": "icons/rehelper.png",

    "128": "icons/rehelper.png"

  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/00-namespace.js",
        "content/10-form-filler.js",
        "content/20-widget.js",
        "content/30-orders-api.js",
        "content/40-dashboard.js",
        "content/50-shortcuts.js",
        "content/90-init.js"
      ],
      "all_frames": true
    }
  ]
}
